ARG RUST_BUILD_IMAGE=rust:1.99.1-bookworm
ARG WORKER_RUNTIME_IMAGE=debian:bookworm-slim
FROM ${RUST_BUILD_IMAGE} AS build
WORKDIR /src
COPY rust ./rust
RUN cargo build --locked --manifest-path rust/Cargo.toml -p cos-execd --release

FROM ${WORKER_RUNTIME_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates coreutils curl findutils gawk git grep jq make \
    python3 sed tar xz-utils gzip gcc g++ pkg-config file procps \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/rust/target/release/cos-execd /usr/local/bin/cos-execd
RUN mkdir -p /workspace && chown 65532:65532 /workspace
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["/usr/bin/sleep", "infinity"]
