FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/light-agentd ./control/cmd/light-agentd
RUN mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build --chown=65532:65532 /out/light-agentd /usr/local/bin/light-agentd
COPY --from=build --chown=65532:65532 /out/data /var/lib/light-agent
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/light-agentd"]
