# Required: generate a unique random secret, do not commit the real value.
LIGHT_AGENT_API_TOKEN=replace-with-a-long-random-token
LIGHT_AGENT_LOG_LEVEL=info

# Optional Feishu webhook configuration.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_OPEN_IDS=

# Optional Host Sandbox Manager endpoint. When Control Plane runs in Docker,
# this must be reachable from the container; protect it with a 32+ character token.
LIGHT_AGENT_SANDBOX_MANAGER_URL=
LIGHT_AGENT_SANDBOX_MANAGER_TOKEN=
LIGHT_AGENT_DOCKER_SOCKET=/var/run/docker.sock
LIGHT_AGENT_WASM_RUNTIME=wasmtime
