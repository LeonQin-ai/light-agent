# Required: generate a unique random secret, do not commit the real value.
LIGHT_AGENT_API_TOKEN=replace-with-a-long-random-token
LIGHT_AGENT_LOG_LEVEL=info

# Optional Feishu webhook configuration.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_OPEN_IDS=

# Target Worker backend selection (provider implementation is in progress):
# docker = Docker Engine + runc; sandbox = Docker Engine + gVisor runsc;
# firecracker = Firecracker + Jailer (requires /dev/kvm).
LIGHT_AGENT_EXECUTION_BACKEND=sandbox
LIGHT_AGENT_DOCKER_SOCKET=unix:///var/run/docker.sock
LIGHT_AGENT_DOCKER_RUNTIME=runsc
LIGHT_AGENT_SANDBOX_REQUIRE_GVISOR=true
LIGHT_AGENT_WORKER_IMAGE=
LIGHT_AGENT_WORKER_CPU_LIMIT=1.0
LIGHT_AGENT_WORKER_MEMORY_LIMIT=1g
LIGHT_AGENT_WORKER_PIDS_LIMIT=128
LIGHT_AGENT_WORKER_NETWORK=none
