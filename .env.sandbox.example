# Host Control Plane
LIGHT_AGENT_LISTEN_ADDR=127.0.0.1:8080
LIGHT_AGENT_DB_PATH=./data/light-agent.db
LIGHT_AGENT_API_TOKEN=replace-with-a-long-random-token

# Rust cos-sandboxd
LIGHT_AGENT_SANDBOX_URL=http://127.0.0.1:9090
LIGHT_AGENT_SANDBOX_API_TOKEN=replace-with-a-different-long-random-token
LIGHT_AGENT_SANDBOX_LISTEN_ADDR=127.0.0.1:9090
LIGHT_AGENT_SANDBOX_STATE=/var/lib/light-agent/sandbox/vms.json
LIGHT_AGENT_WORKSPACE_BASE=/var/lib/light-agent/workspaces
JAILER_BIN=/usr/bin/jailer
FIRECRACKER_BIN=/usr/bin/firecracker
JAILER_CHROOT_BASE=/var/lib/light-agent/jailer
FIRECRACKER_KERNEL=/var/lib/light-agent/images/vmlinux
FIRECRACKER_ROOTFS=/var/lib/light-agent/images/guest-rootfs.ext4
FIRECRACKER_UID=1000
FIRECRACKER_GID=1000
FIRECRACKER_VCPU_MAX=8
FIRECRACKER_MEMORY_MIB_MAX=8192
